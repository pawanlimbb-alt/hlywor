rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.uid in ['2aTrlq56lZd3UScCfk7g8g3lBP73'];
    }

    function isOwner(field) {
      return request.auth != null && request.auth.uid == resource.data[field];
    }

    // ── POSTS ──
    match /posts/{postId} {
      // Allows reading if post is published, has no status set, or user is owner/admin
      allow read: if resource.data.status == 'published'
        || !('status' in resource.data)
        || isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.authorUid);
      allow create: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAdmin()
        || isOwner('authorUid');
    }

    // ── PEOPLE ──
    match /people/{personId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAdmin()
        || isOwner('authorUid');
    }

    // ── USERS ──
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin()
        || (request.auth != null && request.auth.uid == resource.data.uid);
    }

    // ── DRAFTS ──
    match /drafts/{draftId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }

    // ── ACTIVITY ──
    match /activity/{activityId} {
      allow read, update: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    // ── FOLLOWS ──
    match /follows/{followId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid;
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.fromUid == request.auth.uid);
      allow update: if false;
    }

    // ── COMMENTS ──
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAdmin()
        || isOwner('authorUid');
    }

    // ── GALLERY ──
    match /gallery/{photoId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.url is string
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAdmin()
        || isOwner('authorUid');
    }

    // ── STICKS ──
    match /sticks/{stickId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid;
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.fromUid == request.auth.uid);
      allow update: if false;
    }

    // ── REACTIONS ──
    match /reactions/{reactionId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if false;
    }

    // ── NOTIFICATIONS ──
    match /notifications/{notifId} {
      allow read, update: if request.auth != null
        && resource.data.toUid == request.auth.uid;
      allow create: if request.auth != null;
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.toUid == request.auth.uid);
    }

    // ── PROMPTS ──
    match /prompts/{promptId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── MICRO NOTES ──
    match /microNotes/{noteId} {
      allow read: if resource.data.visibility == 'global'
        || !('visibility' in resource.data)
        || isAdmin()
        || (request.auth != null && resource.data.authorUid == request.auth.uid)
        || (request.auth != null && resource.data.visibility == 'following');

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 180;

      allow update: if false;
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.authorUid == request.auth.uid);
    }

    // ── PRESENCE (Live Reading Now) ──
    match /presence/{sid} {
      allow read: if true;
      allow write: if true;
    }

    // ── DENY ALL ELSE ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
